# =============================================================================
# API Auth + Roles — Template de configuration
# =============================================================================
# Copier ce fichier vers .env et renseigner les valeurs :
#   cd backend && cp .env.example .env
#
# Ce fichier est versionné. Le fichier .env ne doit JAMAIS l'être.
# =============================================================================

# -----------------------------------------------------------------------------
# Environnement d'exécution (OBLIGATOIRE)
# -----------------------------------------------------------------------------
# Valeurs acceptées : development, production
# - development : charge le .env local, désactive les paramètres HTTPS/HSTS
# - production : les variables doivent provenir de l'environnement d'exécution
#   ou d'un gestionnaire de secrets
DJANGO_ENV=development

# -----------------------------------------------------------------------------
# Mode debug
# -----------------------------------------------------------------------------
# True uniquement en développement local.
# Doit impérativement être False en staging et production.
DEBUG=True

# -----------------------------------------------------------------------------
# Clé secrète Django
# -----------------------------------------------------------------------------
# Utilisée pour la signature cryptographique Django.
# Vérifier séparément la configuration de signature JWT.
# Minimum 50 caractères avec bonne entropie.
# Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_WITH_A_STRONG_SECRET_KEY_OF_AT_LEAST_50_CHARACTERS

# -----------------------------------------------------------------------------
# Hôtes et CORS
# -----------------------------------------------------------------------------
# Liste des noms d'hôtes autorisés (séparés par des virgules, sans espace).
ALLOWED_HOSTS=localhost,127.0.0.1

# Liste des origines CORS autorisées (séparées par des virgules).
# En production : OBLIGATOIRE, au moins une origine HTTPS valide.
# Une valeur vide en production déclenche ImproperlyConfigured.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=auth_roles_db
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Rate limiting (AUTH-033)
# -----------------------------------------------------------------------------
# Limite de débit des endpoints d'authentification sensibles.
# Format DRF : "nombre/fenêtre" (ex: "10/minute", "100/hour")
THROTTLE_AUTH_RATE=10/minute

# -----------------------------------------------------------------------------
# Durcissement HTTPS / HSTS (production uniquement)
# -----------------------------------------------------------------------------
# Ces variables sont ignorées en développement (DEBUG=True).
# Effectives uniquement lorsque DEBUG=False.

# Redirige toutes les requêtes HTTP vers HTTPS.
# ⚠️ PRÉREQUIS PROXY INVERSE (Reverse Proxy) :
# Si la terminaison TLS se fait sur un proxy (Nginx, Traefik, Caddy, etc.),
# Django verra le tronçon interne comme du HTTP et entrera dans une boucle
# de redirection infinie (infinite redirect loop) si SECURE_PROXY_SSL_HEADER
# n'est pas configuré correctement.
# Valeurs acceptées : true, false, 1, 0, yes, no, on, off
SECURE_SSL_REDIRECT=true

# Durée (en secondes) pendant laquelle le navigateur force le HTTPS.
# Commencer par 3600 (1 heure), puis augmenter après validation.
# Valeur recommandée en production stable : 31536000 (1 an).
SECURE_HSTS_SECONDS=3600

# Applique HSTS à tous les sous-domaines.
# Valeurs acceptées : true, false, 1, 0, yes, no, on, off
SECURE_HSTS_INCLUDE_SUBDOMAINS=true

# Autorise l'inclusion du domaine dans la liste preload HSTS des navigateurs.
# Activer uniquement si le domaine entier peut être servi en HTTPS.
# Valeurs acceptées : true, false, 1, 0, yes, no, on, off
SECURE_HSTS_PRELOAD=false

# Détection du protocole original derrière un reverse proxy.
# Active SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https").
# ⚠️ N'activer QUE si le proxy inverse est de confiance, qu'il supprime
# (strip) systématiquement tout en-tête X-Forwarded-Proto provenant du
# client externe, et qu'il le redéfinit lui-même de manière sécurisée.
# Recommandation : effectuez un test d'intégration à travers le proxy
# pour vérifier l'absence de boucle de redirection avant la mise en prod.
# Valeurs acceptées : true, false, 1, 0, yes, no, on, off
SECURE_PROXY_SSL_HEADER=false